{
  "name": "pdp-feature-monitor",
  "version": "1.0.0",
  "description": "Automated PDP feature monitoring for Natura/Avon sites",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "check": "tsc && node dist/index.js",
    "check:headed": "tsc && cross-env HEADLESS=false node dist/index.js",
    "check:smoke": "tsc && cross-env MODE=smoke node dist/index.js",
    "perf": "tsc && node dist/perf/index.js",
    "test": "npx playwright test",
    "test:unit": "npx playwright test src/tests/",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "perf:local": "tsc && cross-env PERF_OUTPUT_DIR=reports/perf node dist/perf/index.js",
    "perf:ci": "tsc && cross-env PERF_OUTPUT_DIR=docs/perf node dist/perf/index.js"
  },
  "keywords": [
    "playwright",
    "monitoring",
    "pdp",
    "natura",
    "avon"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.19.40",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-playwright": "^2.10.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {
    "chrome-launcher": "^1.2.2",
    "firebase-admin": "^14.3.0",
    "lighthouse": "^12.8.2"
  }
}
