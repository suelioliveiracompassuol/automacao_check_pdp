# PDP Feature Monitor — variáveis de ambiente
# Copie para .env.local e preencha os valores necessários (.env.local já está no .gitignore).

# ── Web (Playwright) ───────────────────────────────────────────────────────
# Filtra por feature(s) específica(s), separadas por vírgula (ex.: "reviews,rating")
FEATURES_FILTER=

# Filtra por operação(ões) específica(s), separadas por vírgula (ex.: "natura-BR,avon-BR")
OPERATIONS_FILTER=

# ── Android (WebdriverIO + Appium) ─────────────────────────────────────────
# Rodado via `npm run check:android` (src/index.android.ts)

# Provider do device farm: "browserstack" | "lambdatest" | "local" (default: lambdatest)
DEVICE_FARM_PROVIDER=lambdatest

# Appium local (só usado quando DEVICE_FARM_PROVIDER=local)
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
ANDROID_APP_PATH=
ANDROID_APK_PATH=
ANDROID_DEVICE_NAME=
ANDROID_OS_VERSION=

# BrowserStack App Automate (quando DEVICE_FARM_PROVIDER=browserstack)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_APP_ID=

# LambdaTest App Automate (quando DEVICE_FARM_PROVIDER=lambdatest, default)
LAMBDATEST_USERNAME=
LAMBDATEST_ACCESS_KEY=
# Um APK por app (id lt://...). LAMBDATEST_APP_ID é o Natura BR; os outros só são
# necessários se as operações deles estiverem em ANDROID_OPERATIONS.
LAMBDATEST_APP_ID=
LAMBDATEST_APP_ID_NATURA_LATAM=
LAMBDATEST_APP_ID_AVON=

# Quantas sessões de device rodam em paralelo (piso 1, teto 5; default 2)
ANDROID_CONCURRENCY=2

# Operações a verificar (marca-PAÍS), separadas por vírgula. Default: natura-BR.
# Natura LATAM: natura-AR, natura-CL, natura-CO, natura-PE, natura-MX
# Avon: avon-BR, avon-AR, avon-MX
# Cada app + país roda numa sessão própria, com o aparelho no idioma/região do país.
ANDROID_OPERATIONS=

# SKUs a verificar — lista separada por vírgula (ex.: "NATBRA-70983,NATBRA-76420").
# ANDROID_SKU é um fallback de compatibilidade para um único SKU.
# Se nenhuma das duas for definida, roda os SKUs ecommerce das ANDROID_OPERATIONS.
ANDROID_SKUS=
ANDROID_SKU=

# Sobrescreve o host do deep link da PDP (ex.: para testar um host dev/hml em vez de produção)
ANDROID_DEEPLINK_HOST=

# Sobrescreve o package do app Android resolvido automaticamente por vendor/country
ANDROID_APP_PACKAGE=

# Login (opcional — sem as duas vars da operação, a sessão roda anônima).
# A conta é por operação: ANDROID_LOGIN_EMAIL/PASSWORD é só do Natura BR; as outras
# usam o sufixo _<MARCA>_<PAÍS> e nunca caem na conta do Natura BR.
ANDROID_LOGIN_EMAIL=
ANDROID_LOGIN_PASSWORD=
ANDROID_LOGIN_EMAIL_NATURA_AR=
ANDROID_LOGIN_PASSWORD_NATURA_AR=
ANDROID_LOGIN_EMAIL_NATURA_CL=
ANDROID_LOGIN_PASSWORD_NATURA_CL=
ANDROID_LOGIN_EMAIL_NATURA_CO=
ANDROID_LOGIN_PASSWORD_NATURA_CO=
ANDROID_LOGIN_EMAIL_NATURA_PE=
ANDROID_LOGIN_PASSWORD_NATURA_PE=
ANDROID_LOGIN_EMAIL_NATURA_MX=
ANDROID_LOGIN_PASSWORD_NATURA_MX=
ANDROID_LOGIN_EMAIL_AVON_BR=
ANDROID_LOGIN_PASSWORD_AVON_BR=
ANDROID_LOGIN_EMAIL_AVON_AR=
ANDROID_LOGIN_PASSWORD_AVON_AR=
ANDROID_LOGIN_EMAIL_AVON_MX=
ANDROID_LOGIN_PASSWORD_AVON_MX=

# Captura de rede do LambdaTest (network: true). As commerce flags são lidas da resposta
# /feature-flag que o próprio app recebeu. "false" desliga (a sessão fica mais rápida).
ANDROID_NETWORK_CAPTURE=
